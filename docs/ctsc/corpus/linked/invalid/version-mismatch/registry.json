{
  "format": "ctsc.registry",
  "formatVersion": "0.1.0",
  "registryId": "urn:ctsc:registry:example.order-pricing:1",
  "version": "1.0.0",
  "description": "Order-pricing component used by the CTSC golden traces.",
  "components": [
    {
