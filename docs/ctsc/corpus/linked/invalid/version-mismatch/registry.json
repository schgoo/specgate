              "type": {
                "kind": "primitive",
                "name": "i32"
              }
            },
            {
              "name": "unit_price_cents",
              "type": {
                "kind": "primitive",
                "name": "i64"
              }
            }
          ]
        },
        {
          "name": "CustomerTier",
          "kind": "tagged_union",
          "variants": [
            {
              "name": "Standard"
