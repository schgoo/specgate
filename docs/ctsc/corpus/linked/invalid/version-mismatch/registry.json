                "kind": "named",
                "name": "ShippingRegion"
              }
            },
            {
              "name": "coupon",
              "type": {
                "kind": "tagged_union",
                "variants": [
                  {
                    "name": "Some",
                    "payload": {
                      "kind": "primitive",
                      "name": "string"
                    }
                  },
                  {
                    "name": "None"
                  }
                ]
              }
            }
          ],
          "observations": [
            {
              "name": "subtotal_cents",
