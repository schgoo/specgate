            },
            {
              "name": "discount_cents",
              "type": {
                "kind": "primitive",
                "name": "i64"
              }
            },
            {
              "name": "shipping_cents",
              "type": {
                "kind": "primitive",
                "name": "i64"
              }
            },
            {
              "name": "tax_cents",
              "type": {
                "kind": "primitive",
                "name": "i64"
              }
            },
            {
              "name": "total_cents",
              "type": {
                "kind": "primitive",
                "name": "i64"
              }
            }
          ]
        }
      ]
    }
