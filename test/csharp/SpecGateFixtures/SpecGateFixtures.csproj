<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <GenerateDocumentationFile>true</GenerateDocumentationFile>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <RootNamespace>SpecGateFixtures</RootNamespace>
    <AssemblyName>SpecGateFixtures</AssemblyName>
    <SpecGateWeaverTaskAssembly>$(MSBuildThisFileDirectory)..\..\..\csharp\SpecGate.Weaver\bin\$(Configuration)\netstandard2.0\SpecGate.Weaver.dll</SpecGateWeaverTaskAssembly>
  </PropertyGroup>
  <ItemGroup>
    <Compile Remove="Tests/**" />
  </ItemGroup>
  <ItemGroup>
    <ProjectReference Include="..\..\..\csharp\SpecGate.Annotations\SpecGate.Annotations.csproj" />
    <ProjectReference Include="..\..\..\csharp\SpecGate.Runtime\SpecGate.Runtime.csproj" />
    <ProjectReference Include="..\..\..\csharp\SpecGate.Weaver\SpecGate.Weaver.csproj" ReferenceOutputAssembly="false" PrivateAssets="all" />
  </ItemGroup>
  <ItemGroup>
    <!-- Build-time source generator emitting the real-build witness operation
         (fixture.realbuild_witness). Its output lives in obj/generated, so the
         op is present only in the real compiled assembly, never in globbed
         source — a conformance witness for the harness building the real
         fixture assembly rather than a source-globbed surrogate. -->
    <ProjectReference Include="..\SpecGate.WitnessGenerator\SpecGate.WitnessGenerator.csproj"
                      OutputItemType="Analyzer" ReferenceOutputAssembly="false" />
  </ItemGroup>
  <ItemGroup>
    <!-- External NuGet dependency used by the cross_dep fixture (ParseYamlKey),
         the C# twin of the Rust cross_dep fixture's serde_yaml. Exercises that
         the harness builds the fixture's real assembly (resolving package
         references) rather than reconstructing a surrogate from globbed source. -->
    <PackageReference Include="YamlDotNet" Version="16.3.0" />
  </ItemGroup>
  <Import Project="..\..\..\csharp\SpecGate.Weaver\SpecGateWeave.targets" />
</Project>
