<Project Sdk="Microsoft.NET.Sdk">

  <!--
    Deliberately does not import SpecGateWeave.targets, and holds exactly one
    rejected declaration. The weaver fails on the first unsupported declaration
    it finds, so each rejection needs its own assembly to be observable.
  -->
  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>enable</Nullable>
    <IsPackable>false</IsPackable>
    <NoWarn>$(NoWarn);CS1591</NoWarn>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\..\..\csharp\SpecGate.Annotations\SpecGate.Annotations.csproj" />
  </ItemGroup>

</Project>
