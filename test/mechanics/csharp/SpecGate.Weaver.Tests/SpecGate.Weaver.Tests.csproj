<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>enable</Nullable>
    <IsPackable>false</IsPackable>
    <OutputType>Exe</OutputType>
    <NoWarn>$(NoWarn);CS1591</NoWarn>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.NET.Test.Sdk" Version="18.0.1" />
    <!-- Builds the multi-declared assembly the compiler refuses to author. -->
    <PackageReference Include="Mono.Cecil" Version="0.11.6" />
    <PackageReference Include="xunit.v3" Version="3.2.2" />
    <PackageReference Include="xunit.runner.visualstudio" Version="3.1.5" />
  </ItemGroup>

  <ItemGroup>
    <!-- Laid out beside the weaver, runtime, and Cecil, as the shipped weaver directory is. -->
    <Content Include="..\..\..\..\csharp\SpecGate.Weaver\SpecGateCapture.targets;..\..\..\..\csharp\SpecGate.Weaver\SpecGateWeave.targets" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\..\..\..\csharp\SpecGate.Runtime\SpecGate.Runtime.csproj" />
    <ProjectReference Include="..\..\..\support\csharp\SpecGate.TestSupport\SpecGate.TestSupport.csproj" />
    <ProjectReference Include="..\..\..\..\csharp\SpecGate.Weaver\SpecGate.Weaver.csproj" />
    <ProjectReference Include="..\SpecGate.WeaverFixtures\SpecGate.WeaverFixtures.csproj" />
    <ProjectReference Include="..\..\..\rejection\csharp\SpecGate.WeaverNegativeFixtures\SpecGate.WeaverNegativeFixtures.csproj" />
    <ProjectReference Include="..\..\..\rejection\csharp\SpecGate.WeaverGenericMethodFixture\SpecGate.WeaverGenericMethodFixture.csproj" />
    <ProjectReference Include="..\..\..\rejection\csharp\SpecGate.WeaverGenericTypeFixture\SpecGate.WeaverGenericTypeFixture.csproj" />
    <ProjectReference Include="..\..\..\rejection\csharp\SpecGate.WeaverSetupConflictFixture\SpecGate.WeaverSetupConflictFixture.csproj" />
    <ProjectReference Include="..\SpecGate.WeaverSetupFixture\SpecGate.WeaverSetupFixture.csproj" />
  </ItemGroup>

</Project>