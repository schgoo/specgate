<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <RootNamespace>SpecGate.WeaverSetupFixture</RootNamespace>
    <AssemblyName>SpecGate.WeaverSetupFixture</AssemblyName>
    <Version>0.6.0</Version>
    <IsPackable>false</IsPackable>
    <NoWarn>$(NoWarn);CS1591</NoWarn>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\..\..\..\csharp\SpecGate.Annotations\SpecGate.Annotations.csproj" />
    <ProjectReference Include="..\..\..\..\csharp\SpecGate.Runtime\SpecGate.Runtime.csproj" />
    <!-- Ordering only: the weaver runs as a build task, not as a reference. -->
    <ProjectReference Include="..\..\..\..\csharp\SpecGate.Weaver\SpecGate.Weaver.csproj"
                      ReferenceOutputAssembly="false"
                      SkipGetTargetFrameworkProperties="true"
                      Private="false" />
  </ItemGroup>

  <PropertyGroup>
    <SpecGateWeaverDirectory>$(MSBuildThisFileDirectory)..\..\..\..\csharp\SpecGate.Weaver\</SpecGateWeaverDirectory>
    <SpecGateWeaverTaskAssembly>$(SpecGateWeaverDirectory)bin\$(Configuration)\netstandard2.0\SpecGate.Weaver.dll</SpecGateWeaverTaskAssembly>
  </PropertyGroup>

  <Import Project="$(SpecGateWeaverDirectory)SpecGateWeave.targets" />
</Project>
