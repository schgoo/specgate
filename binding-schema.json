{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "SpecGate Component Binding",
  "description": "Maps each component to the named implementations that provide it. Paths are relative to this file.",
  "type": "object",
  "required": ["components"],
  "additionalProperties": false,
  "properties": {
    "components": {
      "type": "object",
      "minProperties": 1,
      "description": "Keys are exact spec_component names. A project that declares several components is listed under each.",
      "propertyNames": { "minLength": 1 },
      "additionalProperties": {
        "$ref": "#/definitions/component"
      }
    }
  },
  "definitions": {
    "component": {
      "type": "object",
      "required": ["implementations"],
      "additionalProperties": false,
      "properties": {
        "implementations": {
          "type": "object",
          "minProperties": 1,
          "description": "Named implementations. The label is unique within the component.",
          "propertyNames": { "minLength": 1 },
          "additionalProperties": {
            "$ref": "#/definitions/implementation"
          }
        }
      }
    },
    "implementation": {
      "type": "object",
      "required": ["language", "sources", "tests"],
      "additionalProperties": false,
      "properties": {
        "language": {
          "type": "string",
          "enum": ["rust", "csharp"]
        },
        "sources": {
          "type": "string",
          "minLength": 1,
          "description": "Directory that discovery and replay build, relative to the binding file."
        },
        "tests": {
          "$ref": "#/definitions/tests"
        },
        "rust": {
          "type": "object",
          "additionalProperties": false,
          "description": "Rust block; valid only when language is rust.",
          "properties": {
            "runtime": {
              "type": "string",
              "enum": ["auto", "arty", "smol", "tokio"],
              "description": "Replay executor. Defaults to detecting the only supported direct candidate dependency."
            },
            "executor": {
              "type": "string",
              "pattern": "^crate::(?:r#)?[A-Za-z_][A-Za-z0-9_]*(?:::(?:r#)?[A-Za-z_][A-Za-z0-9_]*)*$",
              "description": "Candidate function that runs a replay task factory using custom runtime configuration. Mutually exclusive with an explicit runtime other than auto."
            }
          },
          "allOf": [
            {
              "if": { "required": ["executor", "runtime"] },
              "then": { "properties": { "runtime": { "const": "auto" } } }
            }
          ]
        },
        "csharp": {
          "type": "object",
          "additionalProperties": false,
          "description": "C# block; valid only when language is csharp.",
          "properties": {
            "framework": {
              "type": "string",
              "minLength": 1,
              "description": "C# target framework, such as net10.0."
            }
          }
        }
      },
      "allOf": [
        {
          "if": { "properties": { "language": { "const": "rust" } } },
          "then": { "not": { "required": ["csharp"] } }
        },
        {
          "if": { "properties": { "language": { "const": "csharp" } } },
          "then": { "not": { "required": ["rust"] } }
        }
      ]
    },
    "tests": {
      "type": "object",
      "description": "Exactly one of projects or command.",
      "additionalProperties": false,
      "oneOf": [
        { "required": ["projects"] },
        { "required": ["command"] }
      ],
      "properties": {
        "projects": {
          "type": "array",
          "minItems": 1,
          "items": { "type": "string", "minLength": 1 },
          "description": "Test project paths relative to the binding file."
        },
        "command": {
          "type": "string",
          "minLength": 1,
          "pattern": "\\S",
          "description": "Test command (not yet supported for capture, #46). Must contain a non-whitespace character."
        }
      }
    }
  }
}
