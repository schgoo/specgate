<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <GenerateDocumentationFile>true</GenerateDocumentationFile>
    <TargetFramework>netstandard2.0</TargetFramework>
    <LangVersion>latest</LangVersion>
    <Nullable>enable</Nullable>
    <RootNamespace>SpecGate.Runtime</RootNamespace>
    <AssemblyName>SpecGate.Runtime</AssemblyName>
    <Description>Capture runtime invoked by SpecGate woven operation boundaries.</Description>
    <PackageId>SpecGate.Runtime</PackageId>
    <Authors>SpecGate contributors</Authors>
    <PackageTags>specgate;ctsc;capture;runtime</PackageTags>
    <PackageLicenseExpression>MIT OR Apache-2.0</PackageLicenseExpression>
    <PackageProjectUrl>https://github.com/schgoo/specgate</PackageProjectUrl>
    <RepositoryUrl>https://github.com/schgoo/specgate</RepositoryUrl>
    <RepositoryType>git</RepositoryType>
    <PackageRequireLicenseAcceptance>false</PackageRequireLicenseAcceptance>
    <Version>0.6.0</Version>
    <PackageVersion>0.6.0</PackageVersion>
  </PropertyGroup>
  <ItemGroup>
    <ProjectReference Include="..\SpecGate.Annotations\SpecGate.Annotations.csproj" />
  </ItemGroup>
  <ItemGroup>
    <!-- The native capture sidecar is a cross-language protocol, so this runtime
         writes JSON itself rather than handing a model to the CLI. netstandard2.0
         has no in-box JSON writer. -->
    <PackageReference Include="System.Text.Json" Version="8.0.5" />
  </ItemGroup>
</Project>