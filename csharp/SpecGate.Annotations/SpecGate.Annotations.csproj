<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <GenerateDocumentationFile>true</GenerateDocumentationFile>
    <TargetFramework>netstandard2.0</TargetFramework>
    <LangVersion>latest</LangVersion>
    <Nullable>enable</Nullable>
    <RootNamespace>SpecGate.Annotations</RootNamespace>
    <AssemblyName>SpecGate.Annotations</AssemblyName>
    <Description>Annotation metadata for SpecGate CTSC discovery.</Description>
    <PackageId>SpecGate.Annotations</PackageId>
    <Authors>SpecGate contributors</Authors>
    <PackageTags>specgate;ctsc;annotations;discovery</PackageTags>
    <PackageLicenseExpression>MIT OR Apache-2.0</PackageLicenseExpression>
    <PackageProjectUrl>https://github.com/schgoo/specgate</PackageProjectUrl>
    <RepositoryUrl>https://github.com/schgoo/specgate</RepositoryUrl>
    <RepositoryType>git</RepositoryType>
    <PackageRequireLicenseAcceptance>false</PackageRequireLicenseAcceptance>
    <PackageReadmeFile>README.md</PackageReadmeFile>
    <Version>0.6.0</Version>
    <PackageVersion>0.6.0</PackageVersion>
  </PropertyGroup>
  <ItemGroup>
    <None Include="README.md" Pack="true" PackagePath="/" />
  </ItemGroup>
</Project>
